# Development defaults; never reuse these fixture settings in production.
NODE_ENV=development
PORT=8787
PAYSH_CATALOG_SOURCE=fixture
PAY_SH_CATALOG_URL=https://pay.sh/api/catalog
PAYSH_ALLOW_FIXTURE_FALLBACK=true
# Production: live + HTTPS URL + false fallback + PostgreSQL URL are mandatory.
DATABASE_URL=
ADMIN_TOKEN=
# Existing alias remains supported; ADMIN_TOKEN takes precedence.
INFOPUNKS_ADMIN_TOKEN=
PAY_SH_INGEST_INTERVAL_MS=300000
INGESTION_ENABLED=true
MONITOR_ENABLED=false
FRONTEND_ORIGIN=
# Preserve existing feature-specific secrets/settings when migrating hosts.
RH_CHAIN_REVIEW_ADMIN_TOKEN=
RH_CHAIN_RPC_URL=
RH_4663_RESOLUTION_PRIVATE_KEY=

# Canonical judgment policy: minimum confidence for proceed.
RECEIPT_PROCEED_CONFIDENCE_THRESHOLD=80
JUDGMENT_TTL_MS=60000
# Disabled until migration 012 and an operational USDG/4663 facilitator are configured.
JUDGMENT_PAYMENT_ENABLED=false
# New paid judgments use USDG on 4663. Historical Base receipts remain readable.
JUDGMENT_NETWORK=eip155:4663
JUDGMENT_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
JUDGMENT_PRICE=0.01
JUDGMENT_FACILITATOR_URL=
JUDGMENT_PAY_TO=
JUDGMENT_RESOURCE_URL=
JUDGMENT_PRICE_USDG=0.01
# Solana judgment settlement is unsupported.
# Free execution proof intake supports finalized Base USDC transfers only.
EXECUTION_PROOF_BASE_RPC_URL=

# Issuer authentication is independent of x402 payment authorization.
# Production paid judgments require an active Ed25519 signing key.
# Keep retired public keys for replay; never reuse key IDs or commit private keys.
JUDGMENT_ISSUER=
JUDGMENT_ISSUER_KEYS_JSON=
JUDGMENT_SIGNING_KEY_ID=
JUDGMENT_SIGNING_PRIVATE_KEY=

# Autonomous economic engine: migration 015; host-only operations via ADMIN_TOKEN.
ECONOMIC_ENGINE_ENABLED=false
ECONOMIC_ENGINE_SHADOW_MODE=true
ECONOMIC_ENGINE_JEV_ENABLED=false
TYPESAFE_API_KEY=
# JSON array of versioned policies with exact assets and atomic spend limits.
ECONOMIC_ENGINE_POLICIES_JSON=[]
# Requires a registered capability-enforcing executor and durable production store.
ECONOMIC_ENGINE_AUTHORIZATION_ENABLED=false
# Separate execution signature domain; public registry must be independently trusted.
EXECUTION_AUTHORIZATION_ISSUER=
EXECUTION_AUTHORIZATION_KEYS_JSON=
EXECUTION_AUTHORIZATION_KEY_ID=
EXECUTION_AUTHORIZATION_PRIVATE_KEY=

# IPX v2 remains inactive until reviewed allocation terms and deployed identities are present.
IPX_LAUNCH_POLICY_PATH=

# Optional finalized Solana provenance collection (registered addresses only).
IPX_SOLANA_RPC_URL=
IPX_SOLANA_WATCH_ADDRESSES=[]
