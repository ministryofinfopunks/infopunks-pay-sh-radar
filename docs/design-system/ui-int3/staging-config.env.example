# REVIEW TEMPLATE ONLY; no service provisioned; G8/G9 HOLD.
# Required operator substitution/approval before use. No secret values in this file.
NODE_ENV=production
RADAR_CONTROLLED_STAGING=true
PORT=10000
PAYSH_CATALOG_SOURCE=live
PAYSH_ALLOW_FIXTURE_FALLBACK=false
PAYSH_BOOTSTRAP_ENABLED=false
INGESTION_ENABLED=false
MONITOR_MODE=disabled
JUDGMENT_PAYMENT_ENABLED=false
MACHINE_EXECUTION_ENABLED=false
MACHINE_DEMO_SEED=false
ECONOMIC_ENGINE_ENABLED=false
ECONOMIC_ENGINE_AUTHORIZATION_ENABLED=false
ECONOMIC_ENGINE_JEV_ENABLED=false
MONITOR_ENABLED=false
MONITOR_ALLOW_PAID_ENDPOINTS=false
OPENAI_DECISIONS_SHADOW_ENABLED=false
EVALUATION_REPUTATION_PROJECTION_ENABLED=false
IPX_PLTR_SHADOW_OBSERVATION_ENABLED=false
IPX_PLTR_SHADOW_CAPACITY_SWEEP_ENABLED=false
RH_CHAIN_AUTOMATION_ENABLED=false
RH_4663_PHASE2_ENABLED=false
RH_4663_PHASE3_ENABLED=false
RH_4663_PHASE3_PUBLICATION_ENABLED=false
RH_4663_AUTO_PUBLICATION_ENABLED=false
RH_4663_EXTERNAL_DISTRIBUTION_ENABLED=false
RH_4663_CAMPAIGN_REHEARSAL_ENABLED=false
# Operator must supply isolated DATABASE_URL, HTTPS synthetic test catalog URL,
# FRONTEND_ORIGIN, fresh JUDGMENT_API_KEYS_JSON digest/owner entries and admin token.
# Production catalog validator requires HTTPS source; do not enable fixture fallback.
# All following authority bindings must be ABSENT, not placeholders:
